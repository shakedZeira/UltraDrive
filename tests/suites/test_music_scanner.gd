# tests/suites/test_music_scanner.gd
extends GdUnitTestSuite

## Folder -> stations mapping, header-only scan, the index cache, cancellation by
## generation and the threaded path. Everything lives in a per-test user:// dir
## filled with generated bytes (never the real music folder).

const U = preload("res://tests/suites/music_test_util.gd")

var _dir: String = ""
var _index: String = ""

func before_test() -> void:
	_dir = U.temp_dir("scan")
	_index = _dir + "_index.json"

func after_test() -> void:
	U.remove_dir(_dir)
	DirAccess.remove_absolute(_index)

func _mp3(title: String, artist: String) -> PackedByteArray:
	var data := U.id3_tag(3, [
		U.frame(3, "TIT2", U.text_payload(0, title)),
		U.frame(3, "TPE1", U.text_payload(0, artist)),
	])
	data.append_array(U.fake_mp3_frames(100))
	return data

func _scan_sync(scanner: MusicScanner, min_age: float = 0.0) -> MusicLibrary:
	scanner.run_sync(_dir, _index, min_age)
	return _drain(scanner)

func _drain(scanner: MusicScanner) -> MusicLibrary:
	var lib := MusicLibrary.new()
	for m in scanner.poll():
		var msg: Dictionary = m
		match String(msg["type"]):
			"meta":
				lib.set_folder_meta(msg["meta"])
			"tracks":
				lib.add_tracks(msg["tracks"])
	return lib

func _populate() -> void:
	U.write_file(_dir + "/loose.mp3", _mp3("Loose Song", "Loose Artist"))
	U.write_file(_dir + "/Rock/a.mp3", _mp3("Rock A", "Rockers"))
	U.write_file(_dir + "/Rock/b.mp3", _mp3("Rock B", "Rockers"))
	U.write_file(_dir + "/Rock/Live/c.ogg", U.ogg_vorbis(["TITLE=Rock Live", "ARTIST=Rockers"], 44100, 44100 * 30))
	U.write_file(_dir + "/Chill/d.wav", MusicStreams.make_sine_wav(1.0))
	U.write_file(_dir + "/Chill/e.flac", U.flac_file(["TITLE=Needs Conv"]))
	U.write_file(_dir + "/Chill/f.m4a", PackedByteArray([1, 2, 3, 4]))
	U.write_file(_dir + "/Chill/id.part.mp3", _mp3("Partial", "X"))
	U.write_file(_dir + "/Chill/notes.txt", PackedByteArray([65]))
	U.write_file(_dir + "/standalone/g.mp3", _mp3("Single", "Solo"))

func test_stations_from_folders() -> void:
	_populate()
	var lib := _scan_sync(MusicScanner.new())
	var names: Array[String] = []
	for s in lib.stations:
		names.append(s.display_name)
	assert_that(names).contains_exactly(["All Songs", "Chill", "Library", "Rock", "Singles"])
	var rock := lib.station_by_id(MusicStation.id_for_folder("Rock"))
	assert_that(rock.track_ids.size()).is_equal(3) # nested Live/ flattens into Rock
	var all := lib.station_by_id(MusicStation.ALL_ID)
	assert_that(all.track_ids.size()).is_equal(6) # loose + 3 rock + wav + single
	var library_station := lib.station_by_id(MusicStation.LIBRARY_ID)
	assert_that(library_station.track_ids).contains_exactly(["loose.mp3"])

func test_part_files_skipped_and_unsupported_counted() -> void:
	_populate()
	var lib := _scan_sync(MusicScanner.new())
	assert_that(lib.tracks.has("Chill/id.part.mp3")).is_false()
	var chill := lib.station_by_id(MusicStation.id_for_folder("Chill"))
	assert_that(chill.track_ids.size()).is_equal(1) # only the wav plays
	assert_that(chill.needs_conversion).is_equal(2) # flac + m4a
	var st := lib.stats()
	assert_that(st["needs_conversion"]).is_equal(2)
	assert_that(st["playable"]).is_equal(6)
	assert_that(lib.status_text()).contains("need conversion")

func test_track_fields_come_from_tags_with_filename_fallback() -> void:
	U.write_file(_dir + "/Mix/05 - Band Name - File Title.wav", MusicStreams.make_sine_wav(0.5))
	U.write_file(_dir + "/Mix/tagged.mp3", _mp3("From Tag", "Tag Artist"))
	var lib := _scan_sync(MusicScanner.new())
	var wav := lib.get_track("Mix/05 - Band Name - File Title.wav")
	assert_that(wav["title"]).is_equal("File Title")
	assert_that(wav["artist"]).is_equal("Band Name")
	assert_that(wav["track_no"]).is_equal(5)
	var mp3 := lib.get_track("Mix/tagged.mp3")
	assert_that(mp3["title"]).is_equal("From Tag")
	assert_that(mp3["artist"]).is_equal("Tag Artist")
	assert_that(mp3["native"]).is_true()
	assert_that(float(mp3["duration_s"])).is_greater(1.0)

func test_station_json_overrides_name_order_and_shuffle() -> void:
	U.write_file(_dir + "/zzz/a.mp3", _mp3("A", "x"))
	U.write_file(_dir + "/aaa/b.mp3", _mp3("B", "y"))
	U.write_file(_dir + "/zzz/station.json", '{"name": "Top Station", "order": 1, "shuffle": false, "color": "#ff7a00"}'.to_utf8_buffer())
	var lib := _scan_sync(MusicScanner.new())
	assert_that(lib.stations[1].display_name).is_equal("Top Station")
	assert_that(lib.stations[1].shuffle).is_false()
	assert_that(lib.stations[1].color.to_html(false)).is_equal("ff7a00")
	assert_that(lib.stations[2].display_name).is_equal("aaa")

func test_sidecar_cover_images_are_linked() -> void:
	U.write_file(_dir + "/Alb/one.mp3", _mp3("One", "A"))
	U.write_file(_dir + "/Alb/one.jpg", U.jpg_bytes())
	U.write_file(_dir + "/Alb/two.mp3", _mp3("Two", "A"))
	U.write_file(_dir + "/Alb/cover.png", U.png_bytes())
	U.write_file(_dir + "/Bare/three.mp3", _mp3("Three", "B"))
	var lib := _scan_sync(MusicScanner.new())
	assert_that(lib.get_track("Alb/one.mp3")["cover_file"]).is_equal("Alb/one.jpg")
	assert_that(lib.get_track("Alb/two.mp3")["cover_file"]).is_equal("Alb/cover.png")
	assert_that(String(lib.get_track("Bare/three.mp3")["cover_file"])).is_equal("")

func test_index_cache_hit_reads_no_files() -> void:
	_populate()
	var first := MusicScanner.new()
	_scan_sync(first)
	assert_that(first.parse_count).is_equal(8) # every audio file (incl. flac / m4a) once
	assert_that(first.cache_hits).is_equal(0)
	var second := MusicScanner.new()
	var lib := _scan_sync(second)
	assert_that(second.parse_count).is_equal(0)
	assert_that(second.cache_hits).is_equal(first.parse_count)
	assert_that(lib.stats()["playable"]).is_equal(6)

func test_changed_file_is_reparsed() -> void:
	U.write_file(_dir + "/a.mp3", _mp3("Before", "X"))
	U.write_file(_dir + "/b.mp3", _mp3("Stable", "X"))
	_scan_sync(MusicScanner.new())
	U.write_file(_dir + "/a.mp3", _mp3("After A Longer Title", "X")) # new size
	var again := MusicScanner.new()
	var lib := _scan_sync(again)
	assert_that(again.parse_count).is_equal(1)
	assert_that(again.cache_hits).is_equal(1)
	assert_that(lib.get_track("a.mp3")["title"]).is_equal("After A Longer Title")

func test_index_for_another_root_or_version_is_ignored() -> void:
	U.write_file(_dir + "/a.mp3", _mp3("A", "X"))
	_scan_sync(MusicScanner.new())
	assert_that(MusicScanner.load_index(_index, _dir).size()).is_equal(1)
	assert_that(MusicScanner.load_index(_index, _dir + "_other").is_empty()).is_true()
	U.write_file(_index, ('{"version": 999, "root": "%s", "entries": {"a.mp3": {}}}' % _dir).to_utf8_buffer())
	assert_that(MusicScanner.load_index(_index, _dir).is_empty()).is_true()
	U.write_file(_index, "not json".to_utf8_buffer())
	assert_that(MusicScanner.load_index(_index, _dir).is_empty()).is_true()

func test_missing_folder_scans_to_nothing() -> void:
	var scanner := MusicScanner.new()
	scanner.run_sync(_dir + "/does_not_exist", _index)
	var lib := _drain(scanner)
	assert_that(lib.order.size()).is_equal(0)

func test_recent_files_are_skipped_while_still_being_copied() -> void:
	U.write_file(_dir + "/fresh.mp3", _mp3("Fresh", "X"))
	var lib := _scan_sync(MusicScanner.new(), 3600.0)
	assert_that(lib.order.size()).is_equal(0)

func test_cancel_drops_stale_messages() -> void:
	U.write_file(_dir + "/a.mp3", _mp3("A", "X"))
	var scanner := MusicScanner.new()
	scanner.run_sync(_dir, _index)
	scanner.cancel() # bumps the generation: the queued results are stale
	assert_that(scanner.poll().size()).is_equal(0)

func test_threaded_scan_of_500_entries_never_blocks_the_main_thread() -> void:
	var tiny := _mp3("T", "A")
	for i in range(500):
		U.write_file("%s/S%d/t%03d.mp3" % [_dir, i % 5, i], tiny)
	var scanner := MusicScanner.new()
	scanner.start(_dir, _index, 0.0)
	var lib := MusicLibrary.new()
	var worst_poll_ms := 0.0
	var done := false
	var deadline := Time.get_ticks_msec() + 20000
	var batches := 0
	while not done and Time.get_ticks_msec() < deadline:
		var t0 := Time.get_ticks_usec()
		var msgs := scanner.poll()
		for m in msgs:
			var msg: Dictionary = m
			match String(msg["type"]):
				"meta":
					lib.set_folder_meta(msg["meta"])
				"tracks":
					lib.add_tracks(msg["tracks"])
					batches += 1
				"done":
					done = true
		worst_poll_ms = maxf(worst_poll_ms, float(Time.get_ticks_usec() - t0) / 1000.0)
		OS.delay_msec(2)
	assert_that(done).is_true()
	assert_that(lib.stats()["playable"]).is_equal(500)
	assert_that(batches).is_greater(1) # delivered in batches, not one lump
	assert_that(scanner.parse_count).is_equal(500)
	assert_that(scanner.is_running()).is_false()
	# Draining one poll (<= a batch of 40 entries) is cheap; rebuilding is the
	# only main-thread work. Generous bound for slow CI machines.
	assert_that(worst_poll_ms).is_less(500.0)

func test_restart_bumps_generation() -> void:
	U.write_file(_dir + "/a.mp3", _mp3("A", "X"))
	var scanner := MusicScanner.new()
	var g1 := scanner.start(_dir, _index)
	var g2 := scanner.start(_dir, _index)
	assert_that(g2).is_greater(g1)
	var deadline := Time.get_ticks_msec() + 10000
	var done := false
	while not done and Time.get_ticks_msec() < deadline:
		for m in scanner.poll():
			if String((m as Dictionary)["type"]) == "done":
				done = true
		OS.delay_msec(2)
	assert_that(done).is_true()
